{
  "version": 3,
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(OneSignalSDKWorker|OneSignalSDKUpdaterWorker)\\.js$",
      "headers": {
        "service-worker-allowed": "/",
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/admin/manifest\\.json$",
      "dest": "/manifest-admin.json"
    },
    {
      "src": "^/afiliada/manifest\\.json$",
      "dest": "/manifest-afiliada.json"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/ssr"
    }
  ]
}