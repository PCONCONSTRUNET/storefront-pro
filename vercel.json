{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "vite build",
  "outputDirectory": "dist/client",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/_shell.html" },
    { "source": "/((?!api/|assets/|_shell|favicon\\.ico|manifest\\.json|icon-512\\.png|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/_shell.html" }
  ]
}
